# Copy to .env and fill in. Never commit .env.

# Schwab API, from https://developer.schwab.com (only needed for dry-run / --source schwab)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1

# PostgreSQL (start it with: docker compose -f deploy/docker-compose.yml up -d)
# When DATABASE_URL is set, price bars and backtest runs are stored in Postgres.
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading
TEST_DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading_test

# Daily summary email (`trading job notify`). In the cloud the password comes from Secret
# Manager (deploy/set-email-password.sh); set these here only to test sending locally.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=          # a Gmail *app password* (https://myaccount.google.com/apppasswords)
# NOTIFY_TO=you@gmail.com   # comma-separated; e.g. add 6085550100@msg.fi.google.com for a text
