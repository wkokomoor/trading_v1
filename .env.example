# Copy to .env and fill in. Never commit .env.

# Schwab API, from https://developer.schwab.com (only needed for dry-run / --source schwab)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1

# PostgreSQL (start it with: docker compose -f deploy/docker-compose.yml up -d)
# When DATABASE_URL is set, price bars and backtest runs are stored in Postgres.
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading
TEST_DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading_test
